<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        h1{
            color: antiquewhite
        }
        .red{
            color: red;
        }
        .yellow{
            color: yellow;
        }
        /* specificity = 10000 */
        .blue{
            color: blue  !important   /* important can replace inline style */
        }

    </style>
</head>
<body>
     <h1 style="color: brown;" class="red yellow blue ">This is the heading<h1>
                
    
</body>
</html>
<!-- important > inline selector > id selector > class attribute selector > element selector > universal selector  -->